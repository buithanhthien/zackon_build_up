# Copy these entries into the existing project-root .env file on the robot PC.
# Do not commit .env; it is already listed in .gitignore.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: choose another model supported by your OpenAI account.
HINDSIGHT_API_LLM_MODEL=gpt-4o

# Optional: change local ports if these TCP ports are already in use.
# HINDSIGHT_API_PORT=8888
# HINDSIGHT_CONTROL_PLANE_PORT=9999
