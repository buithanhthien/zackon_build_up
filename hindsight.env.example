# Copy these entries into the existing project-root .env file on the robot PC.
# Do not commit .env; it is already listed in .gitignore.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: choose another model supported by your OpenAI account.
HINDSIGHT_API_LLM_MODEL=gpt-5.4-mini

# Optional: change local ports if these TCP ports are already in use.
# HINDSIGHT_API_PORT=8888
# HINDSIGHT_CONTROL_PLANE_PORT=9999

# Robot UI memory (defaults below work without adding these entries to .env).
# Persistent storage only; session correction handling stays active when false.
# HINDSIGHT_ENABLED=true
# HINDSIGHT_BANK_ID=beson-corrections
# HINDSIGHT_URL=http://127.0.0.1:8888
