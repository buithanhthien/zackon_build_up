<scene><ambient>0.7 0.7 0.7 1</ambient><background>0.9 0.9 0.9 1</background></scene>
<model name='ground'><static>true</static><link name='body'><collision name='collision'><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name='visual'><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual></link></model>
