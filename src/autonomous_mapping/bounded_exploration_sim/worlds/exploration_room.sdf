<model name='south'><static>true</static><pose>0 -8 0.75 0 0 0</pose><link name='body'><collision name='collision'><geometry><box><size>16.4 0.2 1.5</size></box></geometry></collision><visual name='visual'><geometry><box><size>16.4 0.2 1.5</size></box></geometry><material><diffuse>0.5 0.6 0.7 1</diffuse></material></visual></link></model>
<model name='east'><static>true</static><pose>8 0 0.75 0 0 0</pose><link name='body'><collision name='collision'><geometry><box><size>0.2 16.4 1.5</size></box></geometry></collision><visual name='visual'><geometry><box><size>0.2 16.4 1.5</size></box></geometry><material><diffuse>0.5 0.6 0.7 1</diffuse></material></visual></link></model>
<model name='west'><static>true</static><pose>-8 0 0.75 0 0 0</pose><link name='body'><collision name='collision'><geometry><box><size>0.2 16.4 1.5</size></box></geometry></collision><visual name='visual'><geometry><box><size>0.2 16.4 1.5</size></box></geometry><material><diffuse>0.5 0.6 0.7 1</diffuse></material></visual></link></model>
<model name='partition'><static>true</static><pose>3 -4.5 0.75 0 0 0</pose><link name='body'><collision name='collision'><geometry><box><size>0.2 7 1.5</size></box></geometry></collision><visual name='visual'><geometry><box><size>0.2 7 1.5</size></box></geometry><material><diffuse>0.5 0.6 0.7 1</diffuse></material></visual></link></model>
</world></sdf>
